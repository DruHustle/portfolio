{
  "name": "portfolio",
  "homepage": "https://andrewgotora.com/",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @portfolio/frontend dev",
    "dev:frontend": "pnpm --filter @portfolio/frontend dev",
    "dev:backend": "pnpm --filter @portfolio/backend dev",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "pnpm --filter @portfolio/frontend build",
    "build:backend": "pnpm --filter @portfolio/backend build",
    "start": "pnpm --filter @portfolio/backend start",
    "preview": "pnpm --filter @portfolio/frontend preview",
    "check": "pnpm -r check",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "test:frontend": "pnpm --filter @portfolio/frontend test",
    "test:backend": "pnpm --filter @portfolio/backend test",
    "test:e2e": "pnpm --filter @portfolio/frontend test:e2e",
    "perf": "pnpm --filter @portfolio/frontend perf",
    "docs:build": "pnpm --filter @portfolio/frontend docs:build",
    "icons:build": "pnpm --filter @portfolio/frontend icons:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pnpm": "^10.34.7",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "express>body-parser": "1.20.9",
      "tailwindcss>nanoid": "3.3.18",
      "lodash@<4.18.0": "4.18.1",
      "lodash-es@<4.18.0": "4.18.1",
      "express>qs": "6.16.1"
    }
  }
}
